{
  "name": "revised-navigator",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "scrape:sections": "node --env-file=.env.local scripts/scrape-sections.mjs",
    "scrape:carta": "node --env-file=.env.local scripts/scrape-carta-class-years.mjs",
    "scrape:syllabi": "node scripts/scrape-syllabi.mjs",
    "dump:catalog": "node --env-file=.env.local scripts/dump-catalog.mjs",
    "typecheck": "tsc --noEmit",
    "build": "next build",
    "test": "vitest run",
    "build:course-links": "esbuild scripts/build-course-links.ts --bundle --platform=node --format=esm --outfile=.tmp-pages/build-course-links.mjs --log-level=error && node .tmp-pages/build-course-links.mjs",
    "audit:ratings": "esbuild scripts/audit-ratings.ts --bundle --platform=node --format=esm --outfile=.tmp-pages/audit-ratings.mjs --log-level=error --external:@supabase/supabase-js && node .tmp-pages/audit-ratings.mjs",
    "dump:local-ratings": "esbuild scripts/patch-local-dump.ts --bundle --platform=node --format=esm --outfile=.tmp-pages/patch-local-dump.mjs --log-level=error --external:@supabase/supabase-js && node .tmp-pages/patch-local-dump.mjs",
    "label:traffic-class": "node --env-file=.env.local scripts/label-traffic-class.mjs",
    "label:sentiment": "node --env-file=.env.local scripts/label-comment-sentiment.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.95.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "next": "^16.1.1",
    "next-themes": "^0.4.6",
    "nuqs": "^2.8.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "resend": "^6.9.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "uuid": "^13.0.0",
    "virtua": "^0.48.2",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.1",
    "fast-xml-parser": "^5.4.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
