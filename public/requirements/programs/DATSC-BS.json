"r6","name":"Statistics","notes":"Most students should take STATS 191; STATS 203 is available as a more advanced alternative.","t":"courses","items":[["STATS 191","STATS 203"]],"mode":"all"},{"id":"r7","name":"Optimization","notes":"Most students should take one of the MS&E 111 courses; EE 364A is available as a more advanced alternative.","t":"courses","items":[["MS&E 111","MS&E 111DS","MS&E 111X","EE 364A"]],"mode":"all"}]},{"id":"r8","name":"Extended Core","desc":"The Extended Core is specific to each version of the data science major (BS or BA) and offers additional coursework in the methods and frameworks used in each program's theoretical and applied areas of study.","t":"all","children":[{"id":"r9","name":"Multivariable Integration","notes":"Most students should take MATH 52; MATH 62CM is available as a more advanced alternative.","t":"courses","items":[["MATH 52","MATH 62CM"]],"mode":"all"},{"id":"r10","name":"Proof Writing","notes":"The proof-writing course may double count with other requirements in the major.","t":"courses","items":[["CS 103","CS 154"],["MATH 56"],["MATH 61CM","MATH 62CM","MATH 63CM"],["MATH 61DM","MATH 62DM","MATH 63DM"],["MATH 113"],["MATH 115","MATH 171"],["STATS 219"]],"mode":"atLeast","n":1},{"id":"r11","name":"Theoretical Statistics","notes":"We strongly recommend that all students take STATS 118. However, students may substitute course or course in place of both STATS 117 and STATS 118.","t":"courses","items":[["STATS 118"],["STATS 200","STATS 200Q"]],"mode":"all"},{"id":"r12","name":"Stochastic Modeling","t":"courses","items":[["MS&E 221"],["STATS 217"]],"mode":"atLeast","n":1},{"id":"r13","name":"Ethics","notes":"Students who identify another course that explores the intersection between data, technology, and ethics may submit the data science requirement inquiry form to obtain approval from the Program Director.","t":"courses","items":[["BIOE 131"],["COMM 154"],["CS 120"],["CS 139"],["CS 181"],["CS 182"],["NBIO 101"],["POLISCI 145B"]],"mode":"atLeast","n":1}]}]},{"id":"b4","name":"Writing in the Major (WIM)","rules":[{"id":"r14","name":"Writing in the Major (WIM)","notes":"DATASCI 120, DATASCI 192A, DATASCI 192B, and DATASCI 199W double count with the capstone requirement. See capstone requirement for details.","t":"courses","items":[["DATASCI 120"],["DATASCI 192A"],["DATASCI 192B"],["DATASCI 199W"]],"shares":true,"mode":"atLeast","n":1}],"wim":true},{"id":"b5","name":"Capstone","rules":[{"id":"r15","name":"Capstone Experience","desc":"The capstone is a culminating experience completed during senior year. Students choose one of the following options. In addition, each student must participate in the final Capstone Showcase in spring of their senior year.","t":"any","children":[{"id":"r16","name":"The Data Science Experience","notes":"DATASCI 120 double counts with the WIM requirement.","t":"courses","items":[["DATASCI 120"],["DATASCI 190"]],"mode":"all"},{"id":"r17","name":"Data Science Practicum","notes":"DATASCI 192A and DATASCI 192B double count for the capstone and WIM requirements.","t":"courses","items":[["DATASCI 192A"],["DATASCI 192B"]],"mode":"all"},{"id":"r18","name":"Applications of Data Science","notes":"DATASCI 120 double counts with the WIM requirement.","t":"courses","items":[["DATASCI 120"],["DATASCI 194B","DATASCI 194C","DATASCI 194D","DATASCI 194L","DATASCI 194N"]],"mode":"all"},{"id":"r19","name":"Independent Research Project","desc":"Completing DATASCI 120 and an independent research project in data science could also be considered for the capstone requirement; the project must be pre-approved by the program director.\n\n• By the final study list deadline of autumn quarter during senior year, students should join the Canvas page for Independent Research Projects.\n\n• During autumn quarter of senior year, students should find a professor who agrees to supervise the research project.\n\n• By the last day of classes of autumn quarter, students must complete the Proposal to Use Independent Research for Data Science B.S. Capstone form, have it approved by the research advisor, and submit it to the Canvas page for Independent Research Projects. Approval must be obtained from the program director through this process.\n\n• The students should enroll in course (independent study) for a letter grade with the supervising professor in every quarter until they finish conducting the research and creating the report/poster.\n\n• To complete the capstone, the student must submit a final report and approval form signed by their research advisor.","notes":"DATASCI 120 double counts with the WIM requirement.","t":"courses","items":[["DATASCI 120"],["DATASCI 199"]],"mode":"all"},{"id":"r20","name":"Honors Capstone Thesis","notes":"DATASCI 199W is available only to students in the Honors program, and it double counts with the WIM requirement.","t":"courses","items":[["DATASCI 199W"]],"mode":"all"},{"id":"r21","name":"Notation in Science Communication (and DATASCI 120)","desc":"Completing DATASCI 120 and the Notation in Science Communication will satisfy the capstone requirement. Note that students must fulfill all the requirements for the Notation in Science Communication in order to fulfill the capstone requirement.","t":"all","children":[{"id":"r22","name":"Required Courses","t":"courses","items":[["DATASCI 120"],["PWR 91NSC"],["PWR 99ANSC"],["PWR 99BNSC"]],"mode":"all"},{"id":"r23","name":"PWR Elective Courses","desc":"Students must complete one of the PWR 91 courses listed or a PWR194 course that is tagged for the specific notation (aside from PWR 91NSC, which is already required).","notes":"See NSC Overview for specific approved courses.","t":"courses","items":[["PWR 91NK"],["PWR 91KSA"],["PWR 91MF"]],"mode":"atLeast","n":1},{"id":"r24","name":"Non-PWR Elective Course","desc":"An additional (3-5 unit) non-PWR elective course is required to complete the Notation in Science Communication.\nThis website lists sample courses that could qualify as non-PWR elective courses. Students must email notationsc@stanford.edu with their choice of elective course, whether that course is on this list or not, in order for that course to count toward their progress in the Notation. If you have questions about the non-PWR Elective course requirement, email notationsc@stanford.edu.\nWIM courses may not double- count towards both the department and NSC requirements.","t":"text"}]}]}]},{"id":"b6","name":"Honors","rules":[{"id":"r25","name":"Data Science Honors Program","desc":"Students must submit a Data Science Honors Proposal Form describing the concentration for honors work, including the courses they intend to use, by the final study list deadline two quarters before the expected degree conferral quarter. See our website for more information.\nIn addition to meeting all requirements for the BS, the student must:\n\n• Maintain a GPA of at least 3.5 in all major coursework.\n\n• Complete 15 units of upper-level coursework. These 15 units must include at least 6 units of courses that involve substantial independent work, such as small group seminars, research-based courses, or independent reading/research courses (e.g., DATASCI 199).\n\n• Participate in the annual Data Science capstone showcase, where all students who have carried out independent work as part of their degree program (for example, in any of the capstone experiences) will share their learnings with posters, oral presentations, or other media.\n\n• Assemble a final portfolio showcasing the student’s ability to think independently and creatively using data science tools. Students will be provided specific instructions for the portfolio (including time for submission and guidelines). The portfolio will have two components:\n(a) Final report of the independent work experience\n(b) A self-reflection essay summarizing the learning achieved in the area of concentration","t":"text"}],"kind":"optional"},{"id":"b7","name":"Biology and Medicine Subplan","rules":[{"id":"r26","name":"Course at the Intersection of Computation and Biology","t":"courses","items":[["CME 108"],["CME 209"],["CS 161"],["CS 173A"],["CS 270"],["CS 274"],["CS 279"]],"mode":"atLeast","n":1},{"id":"r27","name":"Biology Course Set","t":"any","children":[{"id":"r28","name":"Biology Sequence","t":"courses","items":[["BIO 82"],["BIO 83"],["BIO 84"],["BIO 86"]],"mode":"all"},{"id":"r29","name":"Human Biology Sequence","t":"courses","items":[["HUMBIO 2A"],["HUMBIO 3A"],["HUMBIO 4A"]],"mode":"all"}]}],"kind":"subplan"},{"id":"b8","name":"Computational Neuroscience Subplan","rules":[{"id":"r30","name":"Mathematical Preparation","t":"courses","items":[["MATH 53","MATH 63CM","MATH 131P"],["EE 263"]],"mode":"atLeast","n":1},{"id":"r31","name":"Introduction to Neuroscience","t":"courses","items":[["BIO 102"],["PSYCH 50"],["PSYCH 202"]],"mode":"atLeast","n":1},{"id":"r32","name":"Introduction to Cognitive Psychology","t":"courses","items":[["PSYCH 30"],["PSYCH 35"],["PSYCH 45"]],"mode":"atLeast","n":1},{"id":"r33","name":"Machine Learning for Neuroscience","t":"courses","items":[["STATS 220"],["BMDS 274"],["PSYCH 249"]],"mode":"atLeast","n":1},{"id":"r34","name":"Advanced Neuroscience Electives","notes":"An additional course from the “Machine Learning for Neuroscience” category above can also be taken as an advanced neuroscience elective.","t":"courses","items":[["CS 428A"],["CS 428B"],["DATASCI 194N"],["EDUC 464"],["EDUC 486"],["MUSIC 251"],["MUSIC 451A"],["PHIL 167D"],["PSYCH 154"],["PSYCH 164"],["PSYCH 169"],["PSYCH 209"],["PSYCH 236"],["PSYCH 242"],["PSYCH 263"]],"mode":"atLeast","n":2}],"kind":"subplan"},{"id":"b9","name":"Mathematics and Computation Subplan","rules":[{"id":"r35","name":"Additional Math Course","t":"any","children":[{"id":"r36","name":"Additional Math Course","t":"courses","items":[["MATH 53","MATH 63CM","MATH 62DM"]],"mode":"all"},{"id":"r37","name":"Complete 1 MATH course numbered 100 or above.","t":"courses","items":[["MATH 114"],["MATH 104"],["MATH 10