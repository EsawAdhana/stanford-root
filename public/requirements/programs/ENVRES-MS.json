{"code":"ENVRES-MS","name":"Environment and Resources (MS)","kind":"grad","degree":"MS","year":"2026-27","url":"https://bulletin.stanford.edu/programs/ENVRES-MS","departments":[{"_id":"EIPER","campus":"STANF","chair":[],"displayName":"Emmett Interdisc Prog in Environment and Resources","effectiveEndDate":"","effectiveStartDate":"2022-03-08","id":"EIPER","institution":"STANF","lastSyncErrorRecommendations":[],"lastSyncErrors":[],"lastSyncMergeReportId":"pGf3HxB7yi1iX6Hhhx1h","lastSyncStatus":"success","lastSyncedAt":1792746161625,"name":"Emmett Interdisc Prog in Environment and Resources","status":"Active","subjectCodes":["ENVRES"],"workflowStep":{"participants":[{"userId":"mikediaz@stanford.edu","canVote":true,"canComment":true,"canSuspend":false,"canSendBack":true,"canEdit":true,"canEditWorkflow":false,"canForceApprove":false,"requiredToComment":false,"customDecisions":{"__wildcard":true}},{"userId":"hillferg@stanford.edu","canVote":true,"canComment":true,"canSuspend":false,"canSendBack":true,"canEdit":true,"canEditWorkflow":false,"canForceApprove":false,"requiredToComment":false,"customDecisions":{"__wildcard":true}},{"userId":"tarenas@stanford.edu","canVote":true,"canComment":true,"canSuspend":false,"canSendBack":true,"canEdit":true,"canEditWorkflow":false,"canForceApprove":false,"requiredToComment":false,"customDecisions":{"__wildcard":true}},{"userId":"vmoss@stanford.edu","canVote":true,"canComment":true,"canSuspend":false,"canSendBack":true,"canEdit":true,"canEditWorkflow":false,"canForceApprove":false,"requiredToComment":false,"customDecisions":{"__wildcard":true}}],"committees":[],"votesRequiredForApproval":1,"votesRequiredForRejection":1,"ifReject":"author","id":"","name":"Emmett Interdisc Prog in Environment and Resources","required":false,"ifDeadline":"","deadline":{"days":"","months":"","years":""},"hasDeadline":false,"nextStep":"","isRoot":false},"asWorkflowStep":null,"catalogDescription":"","catalogDisplayName":"","catalogImageUrl":"","createdAt":1792746161630,"createdBy":"","customFields":{},"hideInEvents":false,"hideInScheduling":false,"institutionId":"","lastEditedAt":1792746161630,"lastEditedBy":"","scheduleValidationWorkflowId":"","sisId":"","smWorkflowStep":null,"institutions":["STANF"]}],"blocks":[{"id":"mAbEGmbJ","name":"Program Requirements","rules":[{"id":"ov-envres-ms-track","t":"any","name":"Joint MS (with an MBA or JD) or dual MS","children":[{"id":"4bu16pFU","name":"Joint Master's Degree","t":"all","children":[{"id":"VJV0s9Jg","name":"Overview and Unit Requirements","notes":"Overview\nStudents enrolled in the MBA program at the Stanford Graduate School of Business or the JD program at the Stanford Law School can apply for admission to the joint MS in Environment and Resources Degree program. Enrollment in the Joint MS program allows students to pursue an MS degree concurrently with their professional degree and to count a defined number of units toward both degrees, resulting in the award of either an MBA and MS in Environment and Resources degree or a JD and MS in Environment and Resources degree.\nJoint MS students pursue one of E-IPER's six thematic pathways, subject to approval by the student's faculty advisor and E-IPER staff. The joint degree is conferred when the requirements for both the E-IPER MS and the professional degree program have been met. For additional information, see the E-IPER website.\nUnit Requirements\nIn addition to the MBA and JD professional degree requirements, all joint MS students must complete 45 units in EIPER-approved courses.\nJoint M.S.-M.B.A\nThe joint MS-MBA degree program requires 129 units: 84 units for the MBA and 45 units for the MS to be completed in as few as seven but no more than nine academic quarters.\nJoint M.S.-J.D.\nThe joint M.S.-J.D. degree program requires a minimum of 113 units; additional units may be necessary to satisfy all requirements. The JD degree requires 111 units (minimum of 80 Law units and 31 non-Law units), and the MS degree requires 45 units. The joint degree allows up to 43 overlapping units: 31 non-Law units permitted within the JD degree, plus 12 professional school units allowed within the MS degree. The joint MS-JD is to be completed in nine academic quarters.\nAll joint MS students are required to complete the 45 units within the following parameters:\n\n• The student must complete at least 23 units at the 200 level or above. Courses numbered 1 to 99 are not allowable.\n\n• The student must achieve a cumulative 3.0 grade point average (GPA) for all letter-graded courses taken toward the MS degree. Professional school letter-graded courses are not included in the E-IPER GPA calculation but are included in the professional school GPA calculation.\n\n• The student must take all core courses, the human environmental decision-making course, and pathway courses for a letter grade.","t":"text","info":true},{"id":"zATVRPC0","name":"Core Courses","notes":"A letter-graded introductory core course and a capstone project seminar. Students are encouraged to find an E-IPER faculty affiliate as early as possible to serve as a capstone advisor. Contact the E-IPER MS SSO and MS Lecturer for additional guidance.","t":"courses","items":[["ENVRES 280"],["ENVRES 290"]],"mode":"all","letter":true,"reviewed":true},{"id":"atcNygur","name":"Human Environmental Decision-Making Course","notes":"At least one three to five-unit letter-graded course focusing on frames and models useful for decision-making and analyzing environmental, resource, and sustainability challenges. This requirement can also be fulfilled by completing a methods course in the sciences for a letter grade.","t":"courses","items":[["BIO 203","BIO 103","SOC 103"],["CEE 226"],["EARTHSYS 279","EARTHSYS 179","BIO 279"],["EBS 220"],["ECON 155"],["ENERGY 263","CEE 263H"],["ENVRES 250","EARTHSYS 254"],["ESS 166","ESS 266"],["ESS 227","EARTHSYS 227"],["GSBGEN 386"],["MS&E 243"],["MS&E 394"],["SUSTAIN 103"]],"mode":"atLeast","n":1,"letter":true,"minUnitsE