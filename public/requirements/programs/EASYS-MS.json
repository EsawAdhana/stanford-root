["DATASCI 112"],["EARTHSYS 100A"],["EARTHSYS 141"],["EARTHSYS 142"],["EARTHSYS 144"],["EARTHSYS 145"],["EARTHSYS 153"],["EARTHSYS 213"],["EARTHSYS 240"],["ECON 102B"],["GEOPHYS 115"],["OCEANS 140H"],["POLISCI 150A"],["POLISCI 150B"],["POLISCI 150C"]],"mode":"any"}]}]}]},{"id":"b1","name":"Program Requirements","rules":[{"id":"r23","name":"Master's Seminar","t":"courses","items":[["EARTHSYS 290"]],"mode":"all"},{"id":"r24","name":"Master's Thesis (Optional)","desc":"Students who choose to prepare an M.S. thesis, which is not required for the degree, may take up to 8 units of EARTHSYS 299 with their master's advisor and must complete 1 unit of EARTHSYS 299A.","notes":"M.S. Thesis Resources\nApplication Process and Deadlines\nM.S. Thesis Guidelines","t":"courses","items":[["EARTHSYS 299"],["EARTHSYS 299A"]],"optional":true,"mode":"all"},{"id":"r25","name":"Unit Requirement","notes":"The Master of Science degree in Earth Systems allows specialization through graduate-level coursework.\nThe following are required of all M.S. students:\n\n• A minimum of 45 units of coursework and/or research credit (upon approval).\n\n• At least 34 units of the student’s coursework for the master’s program must be at the 200-level or above. All remaining coursework must be at the 100-level or above.\n\n• Up to nine units of research (Earthsys 297 and/or Earthsys 250) may be completed with their Master’s Advisor. This will enrich building mastery in the field through regular communication with their Master's Advisor.\n\n• Students may use 8 units of Earthsys 323: Stanford at Sea towards the required 45 units. Please note- Although the entire 16 unit course must be in your graduate career, only 8 units will be applied towards the required 45 units.","t":"text"}]}]}