lowStep":null,"catalogDescription":"","catalogDisplayName":"","catalogImageUrl":"","createdAt":1792659786357,"createdBy":"","customFields":{},"hideInEvents":false,"hideInScheduling":false,"institutionId":"","lastEditedAt":1792659786357,"lastEditedBy":"","scheduleValidationWorkflowId":"","sisId":"","smWorkflowStep":null,"institutions":["STANF"]}],"blocks":[{"id":"b0","name":"Program Requirements","rules":[{"id":"r0","name":"Requirements Overview","desc":"The Biology minor requires a minimum of six courses meeting the following criteria:\n\n• All courses must be taken for a letter grade (no other grading basis is allowed).\n\n• A minimum total GPA of 2.0 is required in courses taken for the minor.\n\n• All courses must be worth or approved for three or more units.\n\n• At least three courses must be taken at the 100-level or higher. The only courses below 100 that are allowable are one additional BIO 80- level course and OSPAUSTL 10, 28, or 32; note that OSPAUSTL 10, 28, and 32 together count as three courses toward the minor\n\n• The two required 80-series courses for the minor cannot be substituted through transfer credit or any other course (BIO 100-level or higher, approved out-of-department course, or through a submitted General Petition)\n\n• Courses used to fulfill the minor may not be used to satisfy any other department degree requirements (minor or major).\n\n• Stanford Introductory Seminars (IntroSems or Sophomore Seminars) may not be used to fulfill the minor requirements.\nCourses that do NOT count toward the minor:\n\n• Foundational lab courses (BIO 43, BIO 44, BIO 45, BIO 46, BIO 47)\n\n• Capstone courses: BIO 196A, 196B, 196C; BIO 199A, 199B, 199C; BIO 199W\n\n• Out-of-department research (BIO 199X)\n\n• Directed reading (BIO 198, 198X)\n\n• No transfer courses can count toward the BIO 80-series\n\n• HUMBIO Core cannot substitute BIO 80-series courses","t":"text","info":true},{"id":"r1","name":"Biology Foundations Courses","notes":"• Additionally, stud