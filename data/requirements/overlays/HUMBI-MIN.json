{
  "code": "HUMBI-MIN",
  "reviewed": "2026-10-23",
  "summary": "The audit checks the 25 units in at least six courses: three HumBio core courses with at least one A-side and one B-side, then either the electives of a subplan you declare (Global Health, Health Policy or Epidemiology: three listed courses of 3 or more units and, if you like, a fourth listed course of 2 or more units, 10 units in all) or, with no subplan, an individualized plan of one listed HumBio elective and depth electives approved by the HumBio advising team. Every course must be letter graded with a C- or better, taken at Stanford, and not used for another major or minor. Petitions to substitute the core are added by hand.",
  "blocks": {
    "SqWFq7xu": {
      "unlessSubplan": true,
      "why": "\"This option is for students who do not declare an official subplan.\" The Bulletin lets a student finish without a subplan (subplanRequired false), so this block applies only then."
    }
  },
  "nodes": {
    "zJ8S5TRz-text": {
      "why": "\"To earn a minor in Human Biology, undergraduates must complete the minor program of study for at least 25 units, with a minimum of six courses. Core Program Requirement: 15 units / Subplan Elective Requirement: 10 units\". The 25 units are the program minimum and the six courses a program total; the 15 and 10 units are the core and elective rules.",
      "patch": {
        "info": true
      }
    },
